# ---------- Database ----------
POSTGRES_USER=trader
POSTGRES_PASSWORD=trader
POSTGRES_DB=trader_crm
POSTGRES_PORT=5433

# Used by the backend (local dev points at the mapped docker port)
DATABASE_URL=postgresql+psycopg://trader:trader@localhost:5433/trader_crm
# Separate database used by the test suite
TEST_DATABASE_URL=postgresql+psycopg://trader:trader@localhost:5433/trader_crm_test

# ---------- App ----------
APP_NAME=Trader CRM
ENVIRONMENT=development
BACKEND_PORT=8000
LOG_LEVEL=INFO

# ---------- Auth ----------
# openssl rand -hex 32
SECRET_KEY=change-me-in-production-0123456789abcdef0123456789abcdef
ACCESS_TOKEN_EXPIRE_MINUTES=720
JWT_ALGORITHM=HS256

# Seed admin (created by `python -m app.seed`)
SEED_ADMIN_EMAIL=admin@tradercrm.in
SEED_ADMIN_PASSWORD=admin123
SEED_ADMIN_NAME=Trade Desk Admin

# ---------- CORS ----------
# 5173 = admin web app, 5174 = field web app.
# https://localhost and capacitor://localhost are the origins the APK's
# WebView uses on Android and iOS - keep them for device builds.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,https://localhost,capacitor://localhost

# ---------- Frontend ----------
FRONTEND_PORT=5173
# Mobile field app (dev server)
SALESPERSON_PORT=5174
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Business day boundary for "today"/"upcoming" (minutes offset from UTC, 330 = IST)
DISPLAY_TIMEZONE_OFFSET_MINUTES=330
