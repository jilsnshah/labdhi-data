# Copy to android/keystore.properties for signed release builds (never commit it).
#
#   keytool -genkey -v -keystore fieldsales-release.jks -keyalg RSA \
#           -keysize 2048 -validity 10000 -alias fieldsales
#
storeFile=/absolute/path/to/fieldsales-release.jks
storePassword=change-me
keyAlias=fieldsales
keyPassword=change-me
